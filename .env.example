# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/abc_restaurant

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_STAFF_NUMBER=+64xxxxxxxxx

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- STT / TTS (decide vendor per §7 of design doc) ---
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
CARTESIA_API_KEY=

# --- Admin auth ---
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Notifications ---
NOTIFICATION_CHANNELS=sms
TWILIO_SMS_FROM=+64xxxxxxxxx

# --- App ---
PUBLIC_BASE_URL=https://your-domain.example.com
RESTAURANT_TIMEZONE=Pacific/Auckland
RESTAURANT_DEFAULT_CAPACITY=50
ENV=development
LOG_LEVEL=INFO
